// Turns build/<profile>.glb (from scripts/blender/build_human.py) into the shipped files in
// models/<id>/, and writes the manifest the engine imports (src/models/<id>.ts).
//
// Run from packages/avatar-assets: node scripts/build-profiles.mts
import { createHash } from 'node:crypto';
import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { NodeIO } from '@gltf-transform/core';
import { ALL_EXTENSIONS } from '@gltf-transform/extensions';
import { dedup, meshopt, prune, textureCompress } from '@gltf-transform/functions';
import { MeshoptDecoder, MeshoptEncoder } from 'meshoptimizer';
import sharp from 'sharp';
import { ARKIT_BLENDSHAPES, VISEMES } from '../../avatar-types/src/index.ts';
import { eyeCentres } from '../src/build/eyes.ts';
import { materialSettings } from '../src/build/materials.ts';
import { readGlbJson } from '../src/glb.ts';
import { summarizeGltf } from '../src/summary.ts';
import { readSkinnedMesh } from './skinned-mesh.mts';

const PROFILES = {
  high: { maxTexture: 2048, webpQuality: 90 },
  optimized: { maxTexture: 1024, webpQuality: 82 },
} as const;

const human = JSON.parse(readFileSync('sources/human.json', 'utf8'));
const outDir = `models/${human.id}`;
mkdirSync(outDir, { recursive: true });

await MeshoptEncoder.ready;
const io = new NodeIO()
  .registerExtensions(ALL_EXTENSIONS)
  .registerDependencies({ 'meshopt.encoder': MeshoptEncoder, 'meshopt.decoder': MeshoptDecoder });

const files: Record<string, { uri: string; bytes: number; sha256: string; triangles: number }> = {};
let idleMs = 0;
/** Each profile's eye centres; the manifest gets their average (the eye meshes differ by < 1 mm). */
const measured: ReturnType<typeof eyeCentres>[] = [];
for (const [profile, settings] of Object.entries(PROFILES)) {
  const doc = await io.read(`build/${profile}.glb`);
  measured.push(eyeCentres(readSkinnedMesh(doc, 'Eyes')));
  for (const material of doc.getRoot().listMaterials()) {
    const s = materialSettings(material.getName());
    material.setAlphaMode(s.alphaMode).setDoubleSided(s.doubleSided);
    if (s.alphaCutoff !== null) material.setAlphaCutoff(s.alphaCutoff);
    material.setExtension('KHR_materials_clearcoat', null);
  }
  for (const extension of doc.getRoot().listExtensionsUsed()) {
    if (extension.extensionName === 'KHR_materials_clearcoat') extension.dispose();
  }
  for (const animation of doc.getRoot().listAnimations()) {
    if (animation.getName() !== 'idle') continue;
    const inputs = animation.listSamplers().map((s) => s.getInput());
    const start = Math.min(...inputs.map((i) => i?.getMin([0])[0] ?? 0));
    const end = Math.max(...inputs.map((i) => i?.getMax([0])[0] ?? 0));
    idleMs = Math.round((end - start) * 1000);
  }
  await doc.transform(
    dedup(),
    prune(),
    textureCompress({
      encoder: sharp,
      targetFormat: 'webp',
      quality: settings.webpQuality,
      resize: [settings.maxTexture, settings.maxTexture],
    }),
    meshopt({ encoder: MeshoptEncoder, level: 'medium' })
  );
  const bytes = await io.writeBinary(doc);
  writeFileSync(`${outDir}/${profile}.glb`, bytes);
  const summary = summarizeGltf(readGlbJson(bytes, new TextDecoder()));
  files[profile] = {
    uri: `${profile}.glb`,
    bytes: bytes.byteLength,
    sha256: createHash('sha256').update(bytes).digest('hex'),
    triangles: summary.triangles,
  };
  console.log(
    `${profile}: ${(bytes.byteLength / 1e6).toFixed(2)} MB, ${summary.triangles} triangles`
  );
}

const constName = human.id.toUpperCase().replace(/[^A-Z0-9]+/g, '_');
/** Averaged over the profiles, to 0.1 mm. */
const eye = (side: 'left' | 'right') =>
  [0, 1, 2].map(
    (i) =>
      Math.round((measured.reduce((sum, e) => sum + e[side][i], 0) / measured.length) * 1e4) / 1e4
  );
const manifest = {
  id: human.id,
  name: human.name,
  licenses: human.licenses,
  profiles: files,
  morphTargets: {
    arkit: Object.fromEntries(ARKIT_BLENDSHAPES.map((name) => [name, name])),
    visemes: Object.fromEntries(VISEMES.map((v) => [v, `viseme_${v}`])),
  },
  eyes: { left: eye('left'), right: eye('right') },
  skeleton: human.skeleton,
  animations: { idle: { clip: 'idle', durationMs: idleMs, loop: true } },
};
mkdirSync('src/models', { recursive: true });
writeFileSync(
  `src/models/${human.id}.ts`,
  `// Generated by scripts/build-profiles.mts from sources/human.json; rebuild instead of editing.
import type { AvatarAssetManifest } from '@squat-overflow/avatar-types';

export const ${constName} = ${JSON.stringify(manifest, null, 2)} as const satisfies AvatarAssetManifest;
`
);
console.log(`wrote src/models/${human.id}.ts`);
