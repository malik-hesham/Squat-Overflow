{
  // Type-checks the plain JS in this folder. Nothing is emitted: Chrome and Firefox
  // still load the .js files as written, so there is no build step to run.
  //   npm run typecheck   (from extension/; also checks tests/ with tests/tsconfig.json)
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable", "webworker.importscripts"],
    "types": ["chrome"],
    "strict": false
  },
  "include": ["*.js", "*.d.ts", "lib/**/*.js", "lib/vendor/three.d.ts"],
  "exclude": ["node_modules", "lib/vendor"]
}
