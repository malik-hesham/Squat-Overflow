{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Squat Overflow",
  "version": "0.1.0",
  "identifier": "com.squatoverflow.desktop",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "node scripts/sync-web.mjs",
    "beforeBuildCommand": "node scripts/sync-web.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://www.googleapis.com https://oauth2.googleapis.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
