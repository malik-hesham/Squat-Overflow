# Copy to deploy/.env (git-ignored) and fill in. See docs/aws-free-plan.md.

# Hostname whose DNS A record points at the instance's Elastic IP. The store build of the
# extension has this host built in, so choose one you will keep.
DOMAIN=pose.example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com

# Extension origins allowed to open the WebSocket, comma-separated. Add
# chrome-extension://<store-id> after the first Chrome Web Store upload.
FORMCOACH_ALLOWED_ORIGINS=chrome-extension://lpkaoaegdjhciohkfidnmabjigidofnd
# Must match GOOGLE_CLIENT_ID in extension/config.js.
GOOGLE_CLIENT_ID=977942788346-udafursfj3ns2juas0o7c4knj3pvht3h.apps.googleusercontent.com

# Breaks served at the same time; past it new clients get "server busy" (close code 1013).
# 3 suits a t4g.small. Raise it only if latency_ms in frame results stays low under load.
FORMCOACH_MAX_SESSIONS=3

# Generate both with: openssl rand -hex 32
# (hex keeps the password safe inside DATABASE_URL). Changing AUTH_JWT_SECRET signs everyone out.
AUTH_JWT_SECRET=
POSTGRES_PASSWORD=
