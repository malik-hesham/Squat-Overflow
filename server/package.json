{
  "name": "squat-overflow-api",
  "version": "0.0.0",
  "private": true,
  "description": "Squat Overflow API server: optional Google sign-in, team leaderboard and cross-device sync (NestJS + Postgres). Pose analysis runs on the clients.",
  "license": "MIT",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@nestjs/testing": "^12.4.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  }
}
